# Configuration du backend SunuPermis
# Copier ce fichier vers .env puis renseigner les vraies valeurs.
PORT=3000
NODE_ENV=development

# Générer un secret avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Compte administrateur initial (choisir un vrai mot de passe fort)
ADMIN_EMAIL=example@gmail.com
ADMIN_PASSWORD=

# Connexion Postgres : garder vide en développement JSON local.
# Sur Vercel, Neon fournit cette variable après connexion explicite de la base.
DATABASE_URL=
# URL directe optionnelle, utilisée par npm run db:migrate si fournie.
DATABASE_URL_UNPOOLED=

# Clé Gemini côté serveur uniquement (ne jamais la publier)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Origines autorisées, séparées par des virgules. Exemple : https://sunupermis.sn
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://sunupermis.sn
